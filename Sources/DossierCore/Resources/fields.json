{
  "$comment": "The field list: DF-47, with DF-49 (document order), DF-50 (keys are anchors), DF-51 (other characters are plain text) and DF-52 (selected assets only, missing rows, integrity banner, provenance per tab); docs/DOSSIER-FORMAT.md §11. Read-only page content only. Every key, tab keys included, is the anchor and element id of that thing on the page. Renderers lay out in this order and add, drop or reorder nothing. The 'kind' values are DF-47's, spelled as in 'kinds'. 'page.before' comes before the tabs and 'page.after' follows them, on every tab and in print; 'page.after' has no fields today. page.sources is a field of the Profile tab, and keeps its key because footnote marks link to it. emptyText null means the element stays on the page with no content and takes no space. Other keys: 'labelVisible' false keeps the label for assistive technology only; 'textStyle' and 'labelStyle' name data/tokens.json 'type' entries (default for labels: 'label'); 'group' places a Profile field in data/tokens.json layout.profile.",
  "formatVersion": 2,
  "kinds": [
    "text",
    "longText",
    "list",
    "image",
    "imageSet",
    "audio"
  ],
  "sources": {
    "record": "A top-level key of the embedded record (§11).",
    "frontMatter": "A key of CHARACTER.md's front matter (§9.1; record.frontMatter). A list value is a list's items.",
    "section": "CHARACTER.md's body (§9.2; record.body): the body of every ## heading matching 'section' by §9.2's rule, in body order. A parenthetical on a matched heading is shown as written above that body, and the label doesn't change. The text is Markdown. Footnote references become marks that lead to page.sources. Bold names stay bold plain text. Empty means no matching heading, or only whitespace and --- lines under it.",
    "castMember": "A key of the CAST.md member (§3; record.castMember). Empty when the record has no member.",
    "asset": "The selected asset for ('kind', 'variant') (the lookup in §8.1, record.manifest.assets). 'value' is one of the values below. Empty when no asset is selected or the value is absent.",
    "assets": "Every selected asset of 'kind', one row each, in 'order'.",
    "items": "The value is the field's 'items', each with its own key, label, source and empty text, in order.",
    "join": "'parts' read in order, with empty ones left out, joined by 'separator'. Empty when all are.",
    "provenance": "For each selected asset of 'kinds', in the manifest's assets order, its 'parts' with empty ones left out, joined by ' · '. Assets are joined by '; ', all on one line under the tab (§6). Empty when no asset is selected.",
    "findings": "The validator's findings (§14) at render time over the bundle without the page, as the embedded manifest describes it (§11), so the page being replaced is never among them.",
    "tiers": "data/tiers.json at the CAST.md member's role (§8.3). A member with no role has no completeness, so page.completeness shows its empty text and page.missing is empty.",
    "footnotes": "The footnotes of CHARACTER.md's body (§9.3)."
  },
  "values": {
    "path": "The asset's bundle path: its image or audio data as a page copy (DF-43) on an image or audio field, the path as text on a text field.",
    "file": "The last segment of the asset's path.",
    "date": "The first 10 characters of the asset's createdAt.",
    "variant": "The asset's variant.",
    "model": "The asset's model.",
    "sampleText": "The asset's sampleText.",
    "provenance.<key>": "That key of the asset's provenance (§6). A list is joined by ', '.",
    "derivedFrom": "A part with 'derivedFrom' names a role in the asset's derivedFrom (§7) and reads the last segment of that record's path.",
    "frontMatter": "A part with 'frontMatter' reads that key of CHARACTER.md's front matter (§9.1); a dot goes into an object.",
    "literal": "A part with 'literal' is that text.",
    "whenPresent": "A part with 'whenPresent' and 'whenAbsent' shows one of those texts, by whether the value exists.",
    "prefix": "Text put before the part's value when it has one."
  },
