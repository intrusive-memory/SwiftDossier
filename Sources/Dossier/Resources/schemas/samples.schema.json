{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intrusive-memory.github.io/dossier-format/schemas/samples.schema.json",
  "title": "voice/samples.yaml",
  "description": "docs/DOSSIER-FORMAT.md §10 (YAML, validated as its JSON equivalent).",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "variant",
      "text"
    ],
    "properties": {
      "variant": {
        "type": "string",
        "minLength": 1
      },
      "text": {
        "type": "string",
        "minLength": 1
      },
      "model": {
        "type": "string"
      },
      "language": {
        "type": "string"
      },
      "instruct": {
        "type": "string"
      },
      "source": {
        "type": "string"
      }
    }
  }
}
